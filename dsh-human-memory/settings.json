{
  // ==============================================================
  //  DSH 人类记忆插件 · 配置文件（JSONC 格式，支持 // 注释）
  //  直接修改本文件即可调整记忆系统行为，保存后重启 DSH 生效。
  //  所有「权重」字段取值范围见注释；改错导致加载失败时会回退默认值。
  // ==============================================================

  // ---------- 本地存储（记忆库） ----------
  "storage": {
    // 记忆库根目录。留空则使用 $DSH_HOME/human-memory（没有 $DSH_HOME 时退到 ~/.dsh/human-memory）
    "dataDir": "",
    // 旧版单文件记忆库的文件名（仅用于迁移：存在时会自动拆分到 memories/ 目录并备份为 .bak）
    "fileName": "memories.json",
    // 每次写入后是否立即落盘（false 则按 flushIntervalMs 定时落盘，性能更好）
    "syncWrite": false,
    // 定时落盘间隔（毫秒）
    "flushIntervalMs": 5000
  },

  // ---------- 自动自查（每轮对话后自动提取值得记住的信息） ----------
  "autoCapture": {
    // 是否在每轮对话结束后自动自查并写入
    "enabled": true,
    // 内容短于该字符数不自动写入
    "minChars": 8,
    // 每轮最多自动写入几条
    "maxPerTurn": 3,
    // 是否也把 assistant 的回复纳入自查（通常只记用户信息即可）
    "includeAssistant": false
  },

  // ---------- 遗忘曲线（时间衰减）参数 ----------
  "forgetting": {
    // 衰减速度 τ（毫秒）。越大遗忘越慢。参考：1 天 = 86400000
    "tauMs": 86400000,
    // 曲线陡峭指数 c。c<1 表示「先陡后缓」（经典艾宾浩斯曲线）；c>1 表示「先缓后陡」
    "c": 0.3,
    // 是否改用幂律衰减（score = score0 · t^(-β)）代替指数衰减
    "usePowerLaw": false,
    // 幂律衰减指数 β
    "powerBeta": 0.2
  },

  // ---------- 重要性评分权重（六项权重之和应约为 1，插件会归一化） ----------
  "importance": {
    // 自我相关度权重：内容是否涉及用户的目标 / 偏好 / 身份
    "selfRelevance": 0.25,
    // 因果 / 结构权重：内容是否含「因为…所以…」「先…再…」等结构
    "causality": 0.15,
    // 具体性权重：是否含可指认的人名 / 地点 / 数字 / 事件
    "concreteness": 0.15,
    // 独特性权重：是否全新、与已知信息差异大
    "uniqueness": 0.15,
    // 情绪强度权重：是否带强烈情感色彩
    "emotion": 0.10,
    // 记忆时长权重：在同一件事上停留越久，记忆越深刻
    "dwell": 0.20,
    // 记忆时长的饱和参考值（毫秒）：停留时间达到该值后，时长分 ≈ 1
    "dwellRefMs": 60000
  },

  // ---------- 检索排序权重（召回记忆时综合三项） ----------
  "retrieval": {
    // 语义相关度权重 α：记忆内容与当前查询的匹配程度
    "relevance": 0.5,
    // 记忆强度权重 β：已含时间衰减的当前记忆强度
    "strength": 0.3,
    // 重要性权重 γ：写入时计算的内容重要性
    "importance": 0.2
  },

  // ---------- 间隔重复 / 间隔效应 ----------
  "spacing": {
    // 间隔效应强度 κ：同一事件间隔越久再次被提起，加权提升越高
    "kappa": 0.3,
    // 间隔归一化参考（毫秒）
    "spacingTauMs": 86400000,
    // 每次「再次提起」对重要性分数的提升幅度
    "reinforce": 0.05,
    // 重要性分数上限
    "maxImportance": 1.0
  },

  // ---------- 巩固（睡眠巩固的类比） ----------
  "consolidation": {
    // 会话结束后是否自动巩固
    "autoOnTurnEnd": true,
    // 只有当前强度 ≥ 该阈值的情节记忆才参与巩固（只扫高价值部分，不扫全局）
    "strengthThreshold": 0.6,
    // 或「被访问次数」≥ 该阈值也参与巩固
    "minAccessCount": 2,
    // 相似度阈值：两条情节记忆相似度 ≥ 该值才合并为一条语义记忆
    "mergeSimilarity": 0.5,
    // 巩固后是否归档原情节记忆（true 则降低其权重、保留摘要）
    "archiveSource": true
  },

  // ---------- 主动复习 ----------
  "review": {
    // 复习模式："manual"=仅用户用 /memory-review 命令触发；"auto"=DSH 空闲时自动；"off"=关闭
    "mode": "manual",
    // 记忆强度低于该阈值视为「临近期遗忘」，需要复习
    "dueThreshold": 0.4,
    // 自动复习的最小间隔（毫秒），避免频繁打扰
    "minIntervalMs": 3600000,
    // 每次自动复习最多带出的记忆条数
    "maxPerBatch": 5
  },

  // ---------- 工作记忆容量 ----------
  "workingMemory": {
    // 当前对话上下文容量（条），超出后重要内容「溢写」到情节记忆
    "capacity": 7
  }
}
